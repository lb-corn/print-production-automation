PRODUCTION_API=https://lucky-production-automation.swartup.com/api
# Generate a unique random secret with at least 32 characters; match the server configuration.
FACTORY_API_KEY=CHANGE_ME_TO_A_UNIQUE_RANDOM_SECRET
GOOGLE_SERVICE_ACCOUNT_FILE=C:\LuckyBagsFactory\service-account.json
FACTORY_PRINT_DIR=C:\LuckyBagsFactory\factory_print
EDGE_PRINT_HOT_FOLDER=C:\LuckyBagsFactory\edgeprint\incoming
POLL_SECONDS=30
MAX_ARTWORK_MB=100
REQUIRE_DEFENDER_SCAN=true
ALLOW_LOCAL_HTTP=false
# Optional checks detect accidental source/version changes; protect .env and code with Windows ACLs.
REQUIRED_AGENT_VERSION=
REQUIRED_AGENT_SHA256=
