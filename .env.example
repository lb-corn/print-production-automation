APP_NAME="Print Production Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync
FACTORY_API_KEY=REPLACE_WITH_LONG_RANDOM_VALUE
SHOPIFY_STORE=h0yf1i-yt.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# One parent containing LuckyBags and Vibe. Separate partner root IDs are unnecessary.
GOOGLE_DRIVE_FACTORY_ROOT_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Enable authenticated tab reads only after Google Sheets API is enabled.
# MATERIALS_SHEET_ID=
MATERIALS_SHEET_TAB=Lucky
MATERIALS_LUCKY_TAB=Lucky
MATERIALS_VIBE_TAB=Vibe
MATERIALS_AUTHENTICATED=false

# Compare the website backside with sheet-listed backing swatches; confirmation required.
BACKING_COLOR_MATCHING_ENABLED=true
BACKING_SWATCH_FOLDER_NAME="Backside Scan Materials"
BACKING_SWATCH_FOLDER_MAP='{}'
BACKING_PRODUCT_IMAGE_HOSTS=cdn.shopify.com

# Separate Shopify integrations (legacy SHOPIFY_* values remain a Lucky fallback).
LB_SHOP=
LB_CLIENT_ID=
LB_CLIENT_SECRET=
LB_API_VERSION=2026-07
VIBE_SHOP=
VIBE_CLIENT_ID=
VIBE_CLIENT_SECRET=
VIBE_API_VERSION=2026-07
VIBE_ARTWORK_COLLECTION="All Bags"
VIBE_DRIVE_LAYOUT=series
VIBE_BAG_PRODUCT_TYPES="Vibe Bags"
